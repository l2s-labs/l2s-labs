PORT=3000
# URL pública canônica (OG, JSON-LD, sitemap). Ex.: https://l2slabs.com
SITE_URL=

# Opção A — webhook (Discord/Slack/Make/n8n)
LEADS_WEBHOOK_URL=

# Opção B — e-mail via Resend
# onboarding@resend.dev só envia para o e-mail da conta Resend.
# Em produção, use um from@ do seu domínio verificado no Resend.
RESEND_API_KEY=
LEADS_TO_EMAIL=
LEADS_FROM_EMAIL=L2S Labs <onboarding@resend.dev>

# Se true, falha de webhook/Resend retorna 502 ao formulário
LEADS_STRICT=false
